{
  "name": "agentproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "node app/server.mjs",
    "collect": "node agentproof/collect.mjs",
    "collect:mock": "node agentproof/collect.mjs --mock",
    "eval": "node agentproof/eval.mjs",
    "shop": "node agentproof/shop-collect.mjs",
    "shop:mock": "node agentproof/shop-collect.mjs --mock",
    "test": "node --test test/",
    "smoke": "node scripts/smoke.mjs",
    "check": "node --test test/ && node scripts/smoke.mjs",
    "demo": "node scripts/demo-viewer.mjs",
    "live": "node scripts/live-demo.mjs",
    "stability": "node scripts/stability-report.mjs",
    "export": "node scripts/export-benchmarks.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
