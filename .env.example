GEMINI_API_KEY=
# Fill in real model IDs from the AI Studio changelog (Argon / Carbon / Neon / Hydrogen).
# The agent being checked (does not need to be the best model):
MODEL_AGENT=
# Fast model that watches video and reports what is on screen:
MODEL_PERCEIVE=
# Strongest reasoning model, the judge:
MODEL_AUTHOR=
# Single-call baseline (defaults to MODEL_AUTHOR so the comparison is fair):
MODEL_BASELINE=
# Structured calibrated classifier/router via POST /v1beta/decisions (defaults to gemini-decision-1):
MODEL_DECISION=gemini-decision-1
